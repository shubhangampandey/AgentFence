{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm exec vite build",
  "outputDirectory": "dist/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://agentfence-api.onrender.com/api/:path*"
    },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
